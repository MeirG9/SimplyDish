<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewFeed"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:padding="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ProgressBar
        android:id="@+id/progressBarFeed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/recyclerViewFeed"
        app:layout_constraintBottom_toBottomOf="@id/recyclerViewFeed"
        app:layout_constraintStart_toStartOf="@id/recyclerViewFeed"
        app:layout_constraintEnd_toEndOf="@id/recyclerViewFeed" />

    <TextView
        android:id="@+id/tvEmptyState"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="24dp"
        android:text="@string/feed_empty_state"
        android:textColor="@color/text_secondary"
        android:textSize="18sp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/recyclerViewFeed"
        app:layout_constraintBottom_toBottomOf="@id/recyclerViewFeed"
        app:layout_constraintStart_toStartOf="@id/recyclerViewFeed"
        app:layout_constraintEnd_toEndOf="@id/recyclerViewFeed" />

</androidx.constraintlayout.widget.ConstraintLayout>
